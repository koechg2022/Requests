// HTTPS headers
    // Range: string (specifies ranges, e.g., bytes)
    // Referer: string
    // Origin: string
    // Upgrade: string (can specify protocols)
    // Cache-Control: list (of directives)
    // Pragma: string (can specify directives)
    // Expect: string (specifies expectations)
    // X-Requested-With: string
    // DNT (Do Not Track): boolean (1 or 0)
    // TE (Transfer Encoding): list (of encoding types)

namespace requests {


    namespace http_requests {

        // HTTP Response codes
        namespace response_codes {
            const std::string 
                OK = "200",
                MOVED_PERMANENTLY = "301",
                MOVED_TEMPORARILY = "307",
                BAD_REQUEST = "400",
                UNAUTHORIZED = "401",
                FORBIDDEN = "403",
                INTERNAL_SERVER_ERROR = "500";

        }

        typedef std::map<std::string, std::vector<std::string> > http_header;

        const http_header empty_header;

        typedef struct http_response {
            http_header header;
            std::string body;
        } http_response;

        typedef enum {
            length, 
            chunked,
            connection
        } encodings;


