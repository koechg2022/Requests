namespace requests_library {


    // HTTP Response codes
    namespace response_codes {
        const std::string 
            OK = "200",
            MOVED_PERMANENTLY = "301",
            MOVED_TEMPORARILY = "307",
            BAD_REQUEST = "400",
            UNAUTHORIZED = "401",
            FORBIDDEN = "403",
            INTERNAL_SERVER_ERROR = "500";
    }


    /**
    *
    *   @brief Parse a url and retrieve from it a hostname, a port, a path, and a hash.
    *
    *   @param url (`const std::string`) : The url to parse the other values out of.
    *
    *   @param host_name (std::string&) : The reference to fill with the hostname embedded in the url.
    *
    *   @param port (std::string&) : The reference to fill with the port embedded in the url.
    *
    *   @param path (std::string&) : The reference to fill with the path embeded in the url.
    *
    *   @param hash (std::string&) : The reference to fill with the hash embedded in the url.
    *
    *   @returns void
    *
    */
    void parse_url(const std::string& url, std::string& protocol, std::string& hostname, std::string& port, std::string& path, std::string& hash, const std::string default_protocol = "https");

    typedef struct {
        std::map<std::string, std::vector<std::string> > header;
        std::string body;
    } http_response;


    class requests {

        private:
            typedef enum {not_secure, secure_} connection_type;
            connection_type what_to_use;
            networking::network_structures::tcp_client client;
            std::string URL;
            const std::string CONNECTION = "Connection", 
                    USER_AGENT = "User-Agent";
            std::map<std::string, std::vector<std::string> > arguments;

        public:

            requests(const std::string url, bool secure = false);

            ~requests();

            http_response get();

            http_response post();

            http_response delete_();

            http_response pull();

            http_response custom(const std::string method, const std::map<std::string, std::vector<std::string> > headers);

    };

}