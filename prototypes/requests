    class requests;

    namespace request_structures {

        typedef struct {
            std::map<std::string, std::vector<std::string> > header;
            std::string body;
        } http_response;


        class http {
            
            protected:
                networking::network_structures::tcp_client client;
                bool was_init;
                friend requests;
            
            public:

                http();

                http(const std::string url);

                ~http();

                virtual bool connect();

                virtual bool disconnect();

                bool sethost(const std::string new_host);
                
                std::string gethost() const;

                bool setport(const std::string new_port);

                std::string getport() const;

                operator bool() {
                    return not this->client.host_name().empty() and not this->client.port_value().empty();
                }
        };


        class https : public http {

            private:

                SSL_CTX* context;
                SSL* ssl_socket;
                X509* certificate;

                bool initialized_tls_stuff;

                bool initialize();
                
            
            public:

                https();

                https(const std::string url);

                ~https();

                bool connect();

                bool disconnect();

        };

    }


    class requests {

        private:
            typedef enum {not_secure, secure_} connection_type;
            connection_type what_to_use;
            request_structures::http http;
            request_structures::https https;
            const std::string CONNECTION = "Connection", 
                    USER_AGENT = "User-Agent";
            std::map<std::string, std::vector<std::string> > arguments;

        public:

            requests(bool secure = false);

            requests(const std::string url, bool secure = false);

            ~requests();

            request_structures::http_response get();

            request_structures::http_response post();

            request_structures::http_response delete_();

            request_structures::http_response pull();

            request_structures::http_response custom(const std::string method, const std::map<std::string, std::vector<std::string> > headers);

    };

