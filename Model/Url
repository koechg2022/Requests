        };

        class psl_list {

            std::unordered_set<std::string> rules_, exceptions_;

            public:

                psl_list& load_from_text(std::string_view text) {
                    std::size_t start = 0;
                    while (start <= text.size()) {
                        std::size_t nl = text.find('\n', start);
                        std::string_view line = (nl == std::string_view::npos)
                            ? text.substr(start) : text.substr(start, nl - start);
                        while (!line.empty() && (line.front() == ' ' || line.front() == '\t')) line.remove_prefix(1);
                        while (!line.empty() && (line.back() == ' ' || line.back() == '\t' || line.back() == '\r')) line.remove_suffix(1);
                        if (!line.empty() && !(line.size() >= 2 && line[0] == '/' && line[1] == '/')) {
                            if (line.front() == '!') this->exceptions_.emplace(line.substr(1));
                            else                     this->rules_.emplace(line);
                        }
                        if (nl == std::string_view::npos) break;
                        start = nl + 1;
                    }
                    return *this;
                }

                psl_list& load_built_in() {
                    #pragma clang diagnostic push
                    #pragma clang diagnostic ignored "-Wc23-extensions"
                        static constexpr unsigned char suffix_list[] = {
                            #embed PSL_EMBED_PATH
                        };
                    #pragma clang diagnostic pop
                    return this->load_from_text(std::string_view(reinterpret_cast<const char*>(suffix_list), sizeof(suffix_list)));
                }

                bool has_rule(const std::string& rule) const {
                    return this->rules_.contains(rule);
                }

                bool has_exception(const std::string& except) const {
                    return this->exceptions_.contains(except);
                }

        };

        struct host_parts { std::string_view subdomain, domain, top_level_domain; bool ok = false; };

        inline std::vector<std::string_view> split_labels(std::string_view h) {
            std::vector<std::string_view> labels;
            std::size_t start = 0;
            for (;;) {
                std::size_t dot = h.find('.', start);
                if (dot == std::string_view::npos) { labels.push_back(h.substr(start)); break; }
                labels.push_back(h.substr(start, dot - start));
                start = dot + 1;
            }
            return labels;
        }

        inline std::size_t public_suffix_labels(const psl_list& psl, const std::vector<std::string_view>& labels) {
            const std::size_t n = labels.size();
            auto join_from = [&](std::size_t i) {
                std::string s;
                for (std::size_t k = i; k < n; ++k) { if (k > i) s += '.'; s += labels[k]; }
                return s;
            };
            std::size_t index;
            for (index = 0; index < n; ++index)                 // exception rules take priority
                if (psl.has_exception(join_from(index))) return (n - index) - 1;
            std::size_t best = 0; bool matched = false;         // else longest normal/wildcard rule
            for (index = 0; index < n; ++index) {
                const std::size_t len = n - index;
                if (psl.has_rule(join_from(index))) { matched = true; if (len > best) best = len; }
                if (index + 1 < n && psl.has_rule("*." + join_from(index + 1))) { matched = true; if (len > best) best = len; }
            }
            return matched ? best : 1;
        }

        inline host_parts split_host(const psl_list& psl, std::string_view host) {
            host_parts result;
            if (host.empty()) return result;

            std::string lower(host);                                // lowercase copy, for matching only
            for (char& c : lower) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));

            const std::vector<std::string_view> lower_labels = split_labels(lower);
            const std::size_t lower_label_size = lower_labels.size();
            std::size_t suffix_n = public_suffix_labels(psl, lower_labels);

            if (lower_label_size <= suffix_n) {                                    // host is itself a public suffix
                result.top_level_domain = host;
                result.ok = false;
                return result;
            }

            const std::vector<std::string_view> orig = split_labels(host);   // slice ORIGINAL (case preserved)
            const std::size_t domain_label = lower_label_size - suffix_n - 1;
            const std::size_t domain_off = static_cast<std::size_t>(orig[domain_label].data() - host.data());
            const std::size_t tld_off    = static_cast<std::size_t>(orig[lower_label_size - suffix_n].data() - host.data());

            result.top_level_domain = host.substr(tld_off);
            result.domain           = host.substr(domain_off, orig[domain_label].size());
            result.subdomain        = (domain_label == 0) ? std::string_view{} : host.substr(0, domain_off - 1);
            result.ok = true;
            return result;
        }

        // the lazily-loaded singleton
        inline const psl_list& the_psl() {
            static const psl_list list = [] {
                psl_list l;
                l.load_built_in();
                return l;
            }();
            return list;
        }

    }


    namespace requests {



        /**
         * @brief The url that contains all the information:
         *
         *
         * @note This is the rough structure :
         *  scheme://username:password@subdomain.domain.tld:port/path?query=key&value#fragment
         *
         */
        class Url {

            std::string raw_url_;

            std::string_view scheme_, username_, password_,
                subdomain_, domain_, top_level_domain_,
                port_, path_, query_, fragment_;

            nlohmann::json queries_;

            Url& reset(std::string_view& the_view);

            Url& reset_all(const bool raw = false);

            Url& parse();

            Url& assign(std::string raw_url);   // single, non-template home for the same-value short-circuit

            public:

                template <class Source> requires std::constructible_from<std::string, Source>
                explicit(false) Url(Source&& raw_url) : raw_url_(std::forward<Source>(raw_url)) {
                    this->parse();
                }

                Url(const Url& other);

                Url(Url&& other) noexcept;

                ~Url() = default;

                Url& operator=(const Url& other);

                Url& operator=(Url&& other) noexcept;

                template <class Source> requires std::constructible_from<std::string, Source>
                Url& operator=(Source&& raw_url) {
                    return this->assign(std::string(std::forward<Source>(raw_url)));
                }

                template <class Source> requires std::constructible_from<std::string, Source>
                Url& operator()(Source&& raw_url) {
                    return this->operator=<Source>(raw_url);
                }

                template <class Source> requires std::constructible_from<std::string, Source>
                bool operator==(const Source&& other) const {
                    return string_functions::same_string(this->raw_url_, other);
                }

                bool equals(const Url& other, const bool ignore_case = true) const;

                bool operator==(const Url& other) const;

                operator std::string_view() const;

                explicit operator bool() const;

                std::string_view operator[](const std::string_view key) const;

                std::string_view url() const;

                std::string_view scheme() const;

                std::string_view username() const;

                std::string_view password() const;

                std::string_view subdomain() const;

                std::string_view domain() const;

                std::string_view top_level_domain() const;

                const std::string usable_domain() const;

                std::string_view port() const;

                std::string_view path() const;

                std::string_view query() const;

                const nlohmann::json& queries() const;

                std::string_view fragment() const;

                bool empty() const;

                std::size_t hash() const;


        };

    }

