        using components = enum {
            THE_SCHEME    = 2,   // group 1 is "scheme://"; group 2 is the bare scheme name
            THE_AUTHORITY = 3,   // "user:pass@" (group 4 is the userinfo without the @)
            THE_DOMAIN    = 5,
