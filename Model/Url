


#if not defined(_url_)


    #define _url_

    #include <concepts>
    #include <cstddef>
    #include <string>
    #include <string_view>
    #include <utility>
    
    
    

    #include <String Functions>
    #include <nlohmann/json.hpp>


    namespace requests {



        /**
         * @brief The url that contains all the information:
         * 
         *
         * @note This is the rough structure : 
         *  scheme://username:password@subdomain.domain.tld:port/path?query=key&value#fragment
         *
         */
        class Url {

            std::string raw_url_;
            
            std::string_view scheme_, username_, password_,
                subdomain_, domain_, top_level_domain_, 
                port_, path_, query_, fragment_;

            nlohmann::json queries_;

            Url& reset(std::string_view& the_view);

            Url& reset_all(const bool raw = false);

            Url& parse();

            public:

                template <class Source> requires std::constructible_from<std::string, Source>
                explicit(false) Url(Source&& raw_url) : raw_url_(std::forward<Source>(raw_url)) {
                    this->parse();
                }

                Url(const Url& other);

                Url(Url&& other) noexcept;

                ~Url() = default;

                Url& operator=(const Url& other);

                Url& operator=(Url&& other) noexcept;

                template <class Source> requires std::constructible_from<std::string, Source>
                Url& operator=(Source&& raw_url) {
                    if (string_functions::same_string(this->raw_url_, raw_url, false)) return *this;
                    this->raw_url_ = std::forward<Source>(raw_url);
                    this->parse();
                    return *this;
                }

                template <class Source> requires std::constructible_from<std::string, Source>
                Url& operator()(Source&& raw_url) {
                    return this->operator=<Source>(raw_url);
                }

                template <class Source> requires std::constructible_from<std::string, Source>
                bool operator==(const Source&& other) const {
                    return string_functions::same_string(this->raw_url_, other);
                }

                bool equals(const Url& other, const bool ignore_case = true) const;

                bool operator==(const Url& other) const;

                operator std::string_view() const;

                operator bool() const;

                std::string_view url() const;

                std::string_view scheme() const;

                std::string_view username() const;

                std::string_view password() const;

                std::string_view subdomain() const;

                std::string_view domain() const;

                std::string_view top_level_domain() const;

                const std::string usable_domain() const;

                std::string_view port() const;

                std::string_view path() const;

                std::string_view query() const;

                const nlohmann::json& queries() const;

                std::string_view fragment() const;

                bool empty() const;

                std::size_t hash() const;


        };

    }

    namespace std {
        template <> struct hash<requests::Url> {
            std::size_t operator()(const requests::Url& other) const noexcept {
                return other.hash();
            }
        };
    }


#endif