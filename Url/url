            bool same_char(const char a, const char b, const bool ignore_case = true) {
                return ignore_case ? std::toupper(a) == std::toupper(b) : a == b;
            }

            bool same_string(std::string_view first, std::string_view second, const bool ignore_case = true) {
                if (first.length() != second.length()) return false;
                size_t index;
                for (index = 0; index < first.length(); index++) {
                    if (not same_char(first[index], second[index], ignore_case)) return false;
                }
                return true;
            }
        }

